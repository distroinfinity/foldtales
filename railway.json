{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm install --frozen-lockfile --filter @tabletop/backend..."
  },
  "deploy": {
    "startCommand": "pnpm --filter @tabletop/backend start",
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE"
  }
}
