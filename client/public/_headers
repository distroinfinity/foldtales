# Cloudflare Pages headers (lane E). Hashed code never changes under its name; the offline
# worker and the manifest are always checked; everything else keeps Pages' default (revalidate).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
