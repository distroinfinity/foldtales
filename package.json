{
  "name": "tabletop-theater",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tabletop/backend --filter @tabletop/client dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "check:bundle": "node scripts/check-bundle.ts",
    "check": "pnpm typecheck && pnpm test && pnpm check:bundle"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ktx2-encoder": "^0.6.0",
    "sharp": "0.35.4",
    "typescript": "~5.9.0",
    "vite": "^7.3.8",
    "vitest": "^4.0.0"
  }
}
